<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qsb_widget_height" />
            <solid android:color="?attr/folderBackgroundColor" />
        </shape>
    </item>

    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="@dimen/qsb_inner_inset_end">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qsb_widget_height" />
            <solid android:color="@color/materialColorSurfaceBright" />
        </shape>
    </item>
</layer-list>
